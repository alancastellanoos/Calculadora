<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/nums"
        android:layout_alignParentTop="true"
        android:gravity="bottom|end"
        android:maxLines="1"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="60sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="60sp" />

    <LinearLayout
        android:id="@+id/nums"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <LinearLayout style="@style/fila">
            <Button android:id="@+id/btnAC" style="@style/boton3" android:text="AC"/>
            <Button android:id="@+id/btnBorrar" style="@style/boton3" android:text="⌫"/>
            <Button android:id="@+id/btnPorc" style="@style/boton3" android:text="%"/>
            <Button android:id="@+id/btnDiv" style="@style/boton4" android:text="÷"/>
        </LinearLayout>

        <LinearLayout style="@style/fila">
            <Button android:id="@+id/btn7" style="@style/boton2" android:text="7"/>
            <Button android:id="@+id/btn8" style="@style/boton2" android:text="8"/>
            <Button android:id="@+id/btn9" style="@style/boton2" android:text="9"/>
            <Button android:id="@+id/btnMult" style="@style/boton4" android:text="×"/>
        </LinearLayout>

        <LinearLayout style="@style/fila">
            <Button android:id="@+id/btn4" style="@style/boton2" android:text="4"/>
            <Button android:id="@+id/btn5" style="@style/boton2" android:text="5"/>
            <Button android:id="@+id/btn6" style="@style/boton2" android:text="6"/>
            <Button android:id="@+id/btnResta" style="@style/boton4" android:text="-"/>
        </LinearLayout>

        <LinearLayout style="@style/fila">
            <Button android:id="@+id/btn1" style="@style/boton2" android:text="1"/>
            <Button android:id="@+id/btn2" style="@style/boton2" android:text="2"/>
            <Button android:id="@+id/btn3" style="@style/boton2" android:text="3"/>
            <Button android:id="@+id/btnSuma" style="@style/boton4" android:text="+"/>
        </LinearLayout>

        <LinearLayout style="@style/fila">
            <Button android:id="@+id/btn0" style="@style/boton2"
                android:layout_weight="2"
                android:background="@drawable/shape_pill_gris_oscuro"
                android:text="0"/>
            <Button android:id="@+id/btnPunto" style="@style/boton2" android:text="."/>
            <Button android:id="@+id/btnIgual" style="@style/boton4" android:text="="/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
